---
/**
 * 过期文档红色横幅
 * 覆写 Starlight 默认 MarkdownContent（原本仅 <div class="sl-markdown-content"><slot/></div>）
 * 当 front matter outdated: true 时，在正文顶部注入警示横幅
 */
import '@astrojs/starlight/style/markdown.css';

const { entry } = Astro.locals.starlightRoute;
const data = entry.data;

const isOutdated = data.outdated === true;

const formatDate = (d: unknown): string => {
	if (!d) return '未知日期';
	const date = d instanceof Date ? d : new Date(String(d));
	if (Number.isNaN(date.getTime())) return String(d);
	return date.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
};

const maintainers: string[] = Array.isArray(data.maintainers) ? data.maintainers : [];
const maintainerLinks = maintainers
	.map((m) => `<a href="https://github.com/${m}" target="_blank" rel="noopener">@${m}</a>`)
	.join('、');
---

{
	isOutdated && (
		<div class="outdated-banner" role="alert" data-pagefind-ignore>
			<strong>⚠️ 本文档可能已过时</strong>
			<span class="outdated-meta">
				最后更新于 {formatDate(data.lastUpdated)}，内容可能不再适用于当前版本。维护者：
				<Fragment set:html={maintainerLinks || '未指定'} />
			</span>
		</div>
	)
}

<div class="sl-markdown-content"><slot /></div>

<style>
	@layer starlight.core {
		.outdated-banner {
			margin: 0 0 1.25rem;
			padding: 0.9rem 1.1rem;
			border: 1px solid var(--sl-color-red-high, #d93025);
			border-inline-start-width: 0.3rem;
			border-radius: 0.5rem;
			background-color: var(--sl-color-red-low, rgba(217, 48, 37, 0.12));
			color: var(--sl-color-text, inherit);
			line-height: 1.5;
		}
		.outdated-banner strong {
			display: block;
			color: var(--sl-color-red-high, #d93025);
			font-size: 1.02rem;
			margin-bottom: 0.15rem;
		}
		.outdated-meta {
			font-size: 0.92rem;
			opacity: 0.92;
		}
		.outdated-banner a {
			color: var(--sl-color-red-high, #d93025);
			font-weight: 600;
			text-decoration: underline;
		}
	}
</style>
