---
import { getCollection } from 'astro:content';
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import fs from 'node:fs';
import path from 'node:path';

export async function getStaticPaths() {
	const normalizeId = (id: string) => id.replace(/\.(md|mdx)$/, '');
	const entries = await getCollection('docs');
	const docsDir = path.resolve('src/content/docs');
	const categories = new Set<string>();

	for (const entry of entries) {
		const [category, ...rest] = normalizeId(entry.id).split('/');
		if (!category || rest.length === 0) continue;
		categories.add(category);
	}

	return [...categories]
		.filter(
			(category) =>
				!['index.md', 'index.mdx'].some((file) =>
					fs.existsSync(path.join(docsDir, category, file))
				)
		)
		.map((category) => {
			const docs = entries
				.filter((entry) => {
					const id = normalizeId(entry.id);
					return id.startsWith(`${category}/`) && id !== `${category}/index`;
				})
				.map((entry) => ({
					id: normalizeId(entry.id),
					title: entry.data.title,
					description: entry.data.description,
				}))
				.sort((a, b) => a.title.localeCompare(b.title, 'zh-CN'));

			return { params: { category }, props: { category, docs } };
		});
}

const { category, docs } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<StarlightPage
	frontmatter={{
		title: category,
		description: `${category}分类下的调试文档`,
	}}
>
	<p>该分类尚未提供手工索引页，以下入口由构建过程自动生成。</p>
	<ul>
		{docs.map((doc) => (
			<li>
				<a href={`${base}${doc.id}/`}>{doc.title}</a>
				{doc.description && <p>{doc.description}</p>}
			</li>
		))}
	</ul>
</StarlightPage>